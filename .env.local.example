# Supabase — copiá estos valores desde tu proyecto en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=tu-publishable-o-anon-key-aqui

# Alias legacy opcional para herramientas/docs que todavía pidan anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Server-only. Nunca lo uses en componentes cliente ni lo expongas como NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Copia este archivo a .env.local y completá los valores
