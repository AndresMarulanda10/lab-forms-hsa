# Supabase browser/client variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-or-anon-key

# Optional compatibility alias for older Supabase projects/documentation.
# Keep this value publishable only; never place service-role credentials here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret for administrative scripts or future backend-only jobs.
# Do NOT prefix with NEXT_PUBLIC_ and do NOT expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
